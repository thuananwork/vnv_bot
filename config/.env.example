# ============================================================
# VNV Bot V2 - Production Environment Variables Template
# ============================================================
# HƯỚNG DẪN: Sao chép file này thành .env trong thư mục config/
# và điền các giá trị thực tế tương ứng.
# Ví dụ: copy config\.env.example config\.env
# ============================================================

# ── Application ──────────────────────────────────────────────
NODE_ENV=production
PORT=3000
APP_VERSION=2.0.0

# ── Security ─────────────────────────────────────────────────
JWT_SECRET=<THAY_BANG_CHUOI_BI_MAT_TOI_THIEU_32_KY_TU>
SESSION_SECRET=<CHUOI_BI_MAT_SESSION_GIA_TRI_ROTATE_CACH_NHAU_BOI_DAU_PHAY>
ALLOWED_EMAIL_DOMAINS=vnv.vn,gmail.com
GOOGLE_OAUTH_CLIENT_ID=<GOOGLE_OAUTH_CLIENT_ID>
GOOGLE_OAUTH_CLIENT_SECRET=<GOOGLE_OAUTH_CLIENT_SECRET>
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info
# Các giá trị hợp lệ: trace, debug, info, warn, error, fatal

# ── Safe Mode (Chế độ chỉ đọc) ──────────────────────────────
SAFE_MODE=false
# Khi true: không ghi DB submissions, không sync Sheets, không gửi tin Zalo

# ── Google Sheets ────────────────────────────────────────────
GOOGLE_SHEET_ID=1v_fRM6lVGvxiIizvxoOWfYa4Xnk6plXECdfuaNNU3Xs
# Đặt file credentials.json tại thư mục config/ (không commit)

# ── Database ─────────────────────────────────────────────────
DB_PATH=./data/vnv_bot.db

# ── Scheduler ────────────────────────────────────────────────
BACKUP_CRON=0 2 * * *
# Mặc định: 2 giờ sáng hàng ngày
